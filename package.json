{
    "name": "web-canvas-ui",
    "private": false,
    "version": "0.1.1",
    "type": "module",
    "keywords": [
        "web",
        "canvas",
        "ui",
        "vue",
        "react",
        "Svelte",
        "Angular"
    ],
    "scripts": {
        "dev": "vite",
        "build": "npm run build:theme && tsc && vite build",
        "build:theme": "sass --no-source-map src/canvas-ui/theme.scss src/canvas-ui/theme.css",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "eslint:check": "eslint . --ext .ts,.tsx,.js,.cjs",
        "eslint:fix": "eslint . --ext .ts,.tsx,.js,.cjs --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@angular/core": "^20.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "prettier": "^3.10.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "rxjs": "^7.8.0",
        "sass": "^1.80.0",
        "svelte": "^5.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "vue": "^3.5.0"
    },
    "peerDependencies": {
        "@angular/core": ">=17.0.0",
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0",
        "svelte": ">=5.0.0",
        "vue": ">=3.0.0"
    },
    "peerDependenciesMeta": {
        "@angular/core": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "svelte": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "dependencies": {
        "web-canvas-ui": "^0.1.0"
    },
    "license": "MIT",
    "author": "chunan-qiu wangqingzhou311@live.com https://github.com/Neo20161101/web-canvas-ui",
    "main": "canvas-ui/index.js",
    "description": "Server app that uses the web-canvas-ui package",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    }
}
