{
    "name": "webcanvasui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:theme && tsc && vite build",
        "build:theme": "sass --no-source-map src/canvas-ui/theme.scss src/canvas-ui/theme.css",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "eslint:check": "eslint . --ext .ts,.tsx,.js,.cjs",
        "eslint:fix": "eslint . --ext .ts,.tsx,.js,.cjs --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@angular/core": "^20.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "prettier": "^3.10.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "rxjs": "^7.8.0",
        "sass": "^1.80.0",
        "svelte": "^5.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "vue": "^3.5.0"
    },
    "peerDependencies": {
        "@angular/core": ">=17.0.0",
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0",
        "svelte": ">=5.0.0",
        "vue": ">=3.0.0"
    },
    "peerDependenciesMeta": {
        "@angular/core": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "svelte": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    }
}
